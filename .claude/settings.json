{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/tools/claude-audit.mjs", "hook"], "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/tools/claude-audit.mjs", "hook"], "timeout": 30 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/tools/claude-audit.mjs", "hook"], "timeout": 30 }] },
      { "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/tools/claude-audit.mjs", "hook"], "timeout": 60 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/tools/claude-audit.mjs", "hook"], "timeout": 30 }] },
      { "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/tools/claude-audit.mjs", "hook"], "timeout": 60 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/tools/claude-audit.mjs", "hook"], "timeout": 30 }] },
      { "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/tools/claude-audit.mjs", "hook"], "timeout": 60 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/tools/claude-audit.mjs", "hook"], "timeout": 30 }] }
    ]
  }
}
